## .gitignore for C# / .NET projects
## Based on https://github.com/github/gitignore (Dotnet.gitignore, VisualStudio.gitignore)

# ---------------------------------------------------------------
# Build results
# ---------------------------------------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Pp]ublish/
*.pdb
*.ilk
*.obj
*.tmp
*.tmp_proj
*.log
*.tlog

# .NET Core / SDK
project.lock.json
project.fragment.lock.json
artifacts/
.dotnet/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Publish profiles / outputs
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# ---------------------------------------------------------------
# NuGet
# ---------------------------------------------------------------
/.nuget/packages/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# ---------------------------------------------------------------
# Tests / Code coverage
# ---------------------------------------------------------------
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
CodeCoverage/
TestResults/

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# MSBuild Binary and Structured Log
*.binlog

# ---------------------------------------------------------------
# Visual Studio
# ---------------------------------------------------------------
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
*_i.c
*_p.c
*_h.h
*.meta
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.svclog
*.scc
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb
*.psess
*.vsp
*.vspx
*.sap
*.dbmdl
*.jfm
Generated\ Files/
UpgradeLog*.XML
UpgradeLog*.htm
Backup*/
_UpgradeReport_Files/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# ---------------------------------------------------------------
# JetBrains Rider
# ---------------------------------------------------------------
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/**/usage.statistics.xml
**/.idea/**/dictionaries
**/.idea/**/shelf
**/.idea/**/contentModel.xml
**/.idea/**/projectSettingsUpdater.xml
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.local.xml
**/.idea/**/httpRequests/
**/.idea/**/claudeCode*.xml
**/.idea/**/copilot*
**/.idea/**/discord.xml
*.sln.iml

# ---------------------------------------------------------------
# VS Code
# ---------------------------------------------------------------
**/.vscode/*
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json
!**/.vscode/extensions.json
*.code-workspace

# ---------------------------------------------------------------
# Claude Code (instructions, settings, local state)
# ---------------------------------------------------------------
.claude/
CLAUDE.md
CLAUDE.local.md
**/CLAUDE.md
**/CLAUDE.local.md

# ---------------------------------------------------------------
# OS / Misc
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
~$*
*~
*.swp

# dotenv environment variables file
.env
